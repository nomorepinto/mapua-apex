# Nest server environment.
#
# Locally, when this process is started from mapua-apex-backend-nest, it loads
# the monorepo root `.env` (one directory up) if that file exists, and only
# then a `.env` in this folder. Lambda has no file: set these as process
# environment variables. Copy this file to `.env` here only when you are not
# using the root file.
#
# Do not commit `.env`. `.env.example` is the template.

PORT=3000
APP_ENV=local
NODE_ENV=development

# Leave the keys empty to use the Lambda execution role or the ambient AWS profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Lambda sets AWS_REGION. Nest falls back to it when AWS_DEFAULT_REGION is empty.
AWS_REGION=
# Optional LocalStack or other endpoint. Leave empty for real AWS.
AWS_ENDPOINT=
AWS_COGNITO_REGION=
AWS_COGNITO_ENDPOINT=
AWS_DYNAMODB_REGION=
DYNAMODB_ENDPOINT=
AWS_SES_REGION=ap-southeast-1

# Cognito JWT verification. Pool id looks like ap-southeast-1_xxxxxxxxx.
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# DynamoDB. Session and activity tables fall back to the main table when empty.
AWS_DYNAMODB_TABLE=
AWS_DYNAMODB_SESSION_LOG_TABLE=
AWS_DYNAMODB_ACTIVITY_LOG_TABLE=
LOG_RETENTION_DAYS=90

# Verified SES identity. Sending is skipped when this is empty or hello@example.com.
MAIL_FROM_ADDRESS="hello@example.com"

# CORS. FRONTEND_URL is used when CORS_ALLOWED_ORIGINS is empty.
FRONTEND_URL=http://localhost:5176
CORS_ALLOWED_ORIGINS=

# CloudFront sends X-Origin-Verify. Leave the secret empty locally so the
# check is skipped. On Lambda, set the *_PARAMETER name and leave the plain
# value empty; Nest loads that SSM parameter (WithDecryption) at startup.
ORIGIN_VERIFY_SECRET=
ORIGIN_VERIFY_SECRET_PARAMETER=

# Arcus companion apps. A missing token makes those routes return 503.
ARCUS_SERVICE_TOKEN=
ARCUS_SERVICE_TOKEN_PARAMETER=
ARCUS_ATTENDANCE_URL=
ARCUS_EVALUATION_URL=
ARCUS_POST_EVALUATION_WINDOW_DAYS=3

# Public mailbox check. A missing key returns state "unavailable" (HTTP 200).
EMAILDETECTIVE_BASE_URL=https://api.emaildetective.io
EMAILDETECTIVE_API_KEY=
EMAILDETECTIVE_API_KEY_PARAMETER=

# Public gibberish check. Off, a missing key, or an upstream failure returns
# is_gibberish false and is not cached.
GIBBERISH_CHECK_ENABLED=
GIBBERISH_API_URL=
GIBBERISH_API_KEY=
GIBBERISH_API_KEY_PARAMETER=
GIBBERISH_DETECTOR_VERSION=1
GIBBERISH_CACHE_TTL=3600

# Local only, and only when APP_ENV=local. Lifts the 10-day event-date rule.
VITE_ALLOW_ANY_EVENT_DATE=

# Edge WAF deploy parameters. Nest does not read these. A block should return
# 429 { "message": "Too Many Attempts." }. Session routes are not throttled.
THROTTLE_TTL_SECONDS=60
THROTTLE_READ_LIMIT=60
THROTTLE_WRITE_LIMIT=10
