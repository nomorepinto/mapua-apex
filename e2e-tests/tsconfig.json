{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["playwright.config.ts", "support/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts"]
}
