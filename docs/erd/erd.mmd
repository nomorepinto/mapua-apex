%% mapua-apex - Conceptual ERD (DynamoDB single-table design)
%% Laid out top-down (graph TD) so the diagram renders vertically and fits
%% an 8.5x11 portrait page without horizontal cut-off.
%% Relationships are LOGICAL only: DynamoDB stores no foreign keys, IDs are
%% copied onto items and resolved at write time.
%% DEADLINE REMINDER is intentionally omitted (deprecated: orphaned read path,
%% no producer). See "DynamoDB Schema.txt" -> Deprecated / removed objects.
graph TD
    ORGANIZATION["<b>ORGANIZATION</b><br/>PK = ORGANIZATION#uuid<br/>SK = ORGANIZATION#uuid<br/>------------------<br/>name<br/>is_higher_council<br/>signatories[] : role -&gt; signatory_id"]

    ORG_MEMBER["<b>ORGANIZATION_MEMBER</b><br/>PK = ORGANIZATION#uuid<br/>SK = MEMBER#studentId<br/>------------------<br/>lastname / firstname<br/>student_number<br/>(apex-owned roster)"]

    EVENT["<b>EVENT</b><br/>PK = EVENT#uuid<br/>SK = EVENT#uuid<br/>------------------<br/>sent_at<br/>GSI1PK = ORGANIZATION#uuid<br/>GSI1SK = sent_at"]

    SUBMISSION["<b>SUBMISSION</b><br/>PK = EVENT#uuid<br/>SK = SUBMISSION#uuid<br/>------------------<br/>submission_type / status<br/>current_signatory<br/>signatory_sequence[]<br/>signatory_steps[]<br/>collaboration.dependent_organization_ids[]<br/>activity_classification<br/>activity_details / proponents[]<br/>detailed_budget_proposal<br/>venue_reservation : reservations[]<br/>booking_refs[]<br/>GSI1PK = ORGANIZATION#uuid<br/>GSI2PK = SIGNATORY#uuid (sparse inbox)"]
    SETTINGS["<b>APPROVAL SETTINGS</b><br/>PK = SETTINGS#APPROVAL<br/>SK = SETTINGS#APPROVAL<br/>------------------<br/>osaar_stages[]<br/>updated_at"]

    NOTIFICATION["<b>NOTIFICATION</b><br/>PK = SUBMISSION#uuid<br/>SK = NOTIFICATION#timestamp<br/>------------------<br/>signatory<br/>notif_type<br/>comment"]

    SIGNATORY["<b>SIGNATORY</b><br/>PK = SIGNATORY#uuid<br/>SK = SIGNATORY#uuid<br/>------------------<br/>name / role / department<br/>GSI4PK = ROLE#...<br/>GSI4SK = SIGNATORY#uuid"]

    COLLAB["<b>COLLABORATION POINTER</b><br/>PK = ORGANIZATION#uuid (dependent)<br/>SK = COLLAB#EVENT#id#SUBMISSION#id<br/>------------------<br/>event_id / submission_id / sent_at<br/>index-only, carries no form content"]

    ANNOUNCEMENT["<b>ANNOUNCEMENT</b><br/>PK = ANNOUNCEMENT<br/>SK = timestamp<br/>------------------<br/>content"]

    CAMPUS["<b>CAMPUS</b><br/>PK = CAMPUS#uuid<br/>SK = CAMPUS#uuid<br/>------------------<br/>name<br/>classroom_name_prefixes[] (optional)<br/>classroom_name_digits (optional)"]

    RESERVABLE["<b>RESERVABLE</b><br/>PK = CAMPUS#uuid<br/>SK = RESERVABLE#uuid<br/>------------------<br/>name<br/>type : room / equipment<br/>schedule : mon-sat x 12 bools<br/>min_participants / max_participants (room-only)<br/>is_classroom (room-only)"]

    BOOKING["<b>BOOKING</b><br/>PK = RESERVABLE#uuid<br/>SK = BOOKING#uuid<br/>------------------<br/>timestamp<br/>schedule_selected[] : date + slots<br/>source : submission / cdm<br/>GSI5PK = ORGANIZATION#uuid (submission)<br/>booked_by / reason (cdm)"]

    POSTEVAL["<b>POSTEVAL</b><br/>PK = EVENT#uuid<br/>SK = POSTEVAL#uuid<br/>------------------<br/>entity_type : posteval<br/>status : submitted / approved / denied<br/>submission_id<br/>section_summary (100-500)<br/>financial_report<br/>participation_snapshot<br/>GSI1PK = ORGANIZATION#uuid<br/>GSI1SK = POSTEVAL#uuid"]

    ARCUS_CHILD["<b>EVENT children (arcus-written)</b><br/>PK = EVENT#uuid<br/>SK = MEMBER#studentId / EVALUATION#id<br/>------------------<br/>check-in: member_organization, scannedAt, leftAt<br/>evaluation: studentId, fullName,<br/>&nbsp;&nbsp;participated (yes/no), filedAt<br/>read-only for apex"]

    STUDENT["<b>STUDENT</b> (arcus profile)<br/>PK = STUDENT#studentId<br/>SK = STUDENT#studentId<br/>------------------<br/>full_name / student_id<br/>course / department<br/>(arcus-owned identity)"]

    ORGANIZATION -->|"1 : N &nbsp;(EVENT.GSI1PK)"| EVENT
    ORGANIZATION -->|"1 : N &nbsp;member roster (SK = MEMBER#)"| ORG_MEMBER
    EVENT -->|"1 : N &nbsp;(children share PK = EVENT#id)"| SUBMISSION
    SUBMISSION -->|"1 : N &nbsp;(PK = SUBMISSION#id)"| NOTIFICATION
    ORGANIZATION -->|"M : N &nbsp;desk assignment (signatories[])"| SIGNATORY
    SUBMISSION -->|"M : N &nbsp;approval chain (signatory_sequence)"| SIGNATORY
    SETTINGS -->|"1 : N &nbsp;OSAAR stages for new proposals"| SIGNATORY
    ORGANIZATION -->|"1 : N &nbsp;dependent copies"| COLLAB
    COLLAB -.->|"resolves to master"| SUBMISSION
    CAMPUS -->|"1 : N &nbsp;(RESERVABLE.PK = CAMPUS#id)"| RESERVABLE
    RESERVABLE -->|"1 : N &nbsp;(BOOKING.PK = RESERVABLE#id)"| BOOKING
    SUBMISSION -.->|"references holds (booking_refs)"| BOOKING
    ORGANIZATION -.->|"1 : N &nbsp;org booking list (BOOKING.GSI5PK)"| BOOKING
    EVENT -->|"1 : N &nbsp;(children share PK = EVENT#id)"| POSTEVAL
    EVENT -->|"1 : N &nbsp;(arcus writes MEMBER# / EVALUATION#)"| ARCUS_CHILD
    POSTEVAL -.->|"OSAAR approve finishes linked submission"| SUBMISSION
    ARCUS_CHILD -.->|"aggregated into participation_snapshot"| POSTEVAL
    ARCUS_CHILD -.->|"name resolved from STUDENT# profile"| STUDENT
    ARCUS_CHILD -.->|"members-only gate reads roster"| ORG_MEMBER

    classDef entity fill:#eef4ff,stroke:#3b5bdb,stroke-width:1px,color:#111111,text-align:left;
    class ORGANIZATION,ORG_MEMBER,EVENT,SUBMISSION,NOTIFICATION,SIGNATORY,COLLAB,ANNOUNCEMENT,CAMPUS,RESERVABLE,BOOKING,POSTEVAL,ARCUS_CHILD,STUDENT entity;
