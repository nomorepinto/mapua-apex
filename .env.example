# ═══════════════════════════════════════════════════════════════════
# Root .env.example — mapua-apex monorepo
# Template for the single master env that BOTH projects read.
#
# Copy this file to <repo root>/.env and fill in the secrets. Both apps load
# that root file; neither keeps its own copy:
#
#   Laravel  ← mapua-apex-backend/bootstrap/app.php (useEnvironmentPath)
#   Vite     ← mapua-apex-frontend/vite.config.ts   (envDir)
#
# Only the keys each framework needs are read from there: Laravel ignores the
# VITE_* section, Vite inlines only VITE_* (never the AWS/APP_KEY secrets).
# Values containing spaces must stay quoted — phpdotenv rejects unquoted ones.
#
# Never commit the resulting .env file — the root .gitignore excludes it.
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# BACKEND (Laravel) — read from the root .env by bootstrap/app.php
# ───────────────────────────────────────────────────────────────────
APP_NAME="Mapua APEX"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared IAM credentials for DynamoDB, S3, and SES
# (leave empty to use the instance role / AWS_PROFILE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional LocalStack / custom endpoint for all AWS SDK clients.
# Leave empty for real AWS.
AWS_ENDPOINT=

# S3 (wired; unused until PDF storage)
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_S3_PDF_PREFIX=pdfs

# Cognito (JWT verification only — pool id + SPA app client id)
# Pool id format: <region>_<identifier>, e.g. ap-southeast-1_xxxxxxxxx
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# DynamoDB (single-table name from the infra project)
AWS_DYNAMODB_TABLE=
# Optional DynamoDB-only endpoint (defaults to AWS_ENDPOINT)
DYNAMODB_ENDPOINT=

# Campus-wide desks (plain uuid or SIGNATORY#uuid from POST /admins/signatories).
# PUT the same id to rename the person; do not mint a new uuid.
OSAAR_SIGNATORY_ID=
CDM_SIGNATORY_ID=

# CORS — must match where the frontend dev server actually runs.
# Vite is pinned to :5176 in mapua-apex-frontend/vite.config.ts.
FRONTEND_URL=http://localhost:5176
CORS_ALLOWED_ORIGINS="${FRONTEND_URL}"


# ───────────────────────────────────────────────────────────────────
# FRONTEND (Vite / React) — read from this root file by vite.config.ts
# Every VITE_* variable is baked into the browser bundle at build
# time and is PUBLIC. Never put secrets here.
# ───────────────────────────────────────────────────────────────────
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_8n74mhAnM
VITE_COGNITO_CLIENT_ID=heefkupi7cqt26k6cgsgglujh
VITE_COGNITO_DOMAIN=https://ap-southeast-18n74mhanm.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5176
VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:5176
VITE_COGNITO_SCOPES="openid profile email"

# Backend API base. Use the local Laravel server for co-development,
# or the deployed URL when only working on the frontend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_API_BASE_URL=https://mapua-apex-backend-production-<suffix>.laravel.cloud/api/v1
