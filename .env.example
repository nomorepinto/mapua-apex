# ═══════════════════════════════════════════════════════════════════
# Root .env.example — mapua-apex monorepo
# Template for the single master env that BOTH projects read.
#
# Copy this file to <repo root>/.env and fill in the secrets. Both apps load
# that root file; neither keeps its own copy:
#
#   Nest     ← mapua-apex-backend-nest/src/config/root-env.ts (local dev;
#              Lambda uses the function's environment and has no file)
#   Vite     ← mapua-apex-frontend/vite.config.ts   (envDir)
#
# Vite inlines only VITE_* into the browser bundle (never the AWS/secret keys).
# Nest reads the whole file but does NOT expand ${VAR} references, so write
# literal values everywhere.
#
# Never commit the resulting .env file — the root .gitignore excludes it.
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# BACKEND (Nest) — read by mapua-apex-backend-nest/src/config/app-config.service.ts
# ───────────────────────────────────────────────────────────────────
# local | testing | dev | test count as local-like; anything else is treated as
# production. Falls back to NODE_ENV, then "production".
APP_ENV=local
# Local HTTP port for `npm run start:dev` (default 3000). Routes live under /api/v2.
PORT=3000

# Shared IAM credentials for DynamoDB, Cognito, SES, and SSM
# (leave empty to use the Lambda execution role / AWS_PROFILE)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Default region for every client. Falls back to AWS_REGION (set by Lambda).
AWS_DEFAULT_REGION=us-east-1
# Optional LocalStack / custom endpoint for all AWS SDK clients.
# Leave empty for real AWS.
AWS_ENDPOINT=

# Cognito (JWT verification only — pool id + SPA app client id)
# Pool id format: <region>_<identifier>, e.g. ap-southeast-1_xxxxxxxxx
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
# Optional overrides (default to AWS_DEFAULT_REGION / AWS_ENDPOINT)
AWS_COGNITO_REGION=
AWS_COGNITO_ENDPOINT=

# DynamoDB (single-table name from the infra project)
AWS_DYNAMODB_TABLE=
# Separate tables for the session + activity log system (append-only, TTL-managed).
# Each falls back to AWS_DYNAMODB_TABLE when empty.
AWS_DYNAMODB_SESSION_LOG_TABLE=
AWS_DYNAMODB_ACTIVITY_LOG_TABLE=
# Retention in days for both log tables (DynamoDB TTL). Default: 90.
LOG_RETENTION_DAYS=90
# Optional overrides (default to AWS_DEFAULT_REGION / AWS_ENDPOINT)
AWS_DYNAMODB_REGION=
DYNAMODB_ENDPOINT=

# SES transactional emails (submission/approval notices). Set the region
# explicitly — identities are region-scoped and AWS_DEFAULT_REGION may differ.
# MAIL_FROM_ADDRESS must be a verified SES identity in that region.
AWS_SES_REGION=ap-southeast-1
MAIL_FROM_ADDRESS="hello@example.com"

# CORS — must match where the frontend dev server actually runs.
# Vite is pinned to :5176 in mapua-apex-frontend/vite.config.ts.
FRONTEND_URL=http://localhost:5176
# Comma-separated list. Leave empty to allow FRONTEND_URL only.
CORS_ALLOWED_ORIGINS=

# Secrets. Each can be a plain value (local) or, on Lambda, the name of an SSM
# SecureString parameter in the matching *_PARAMETER key, which Nest loads at
# startup. Set one or the other, not both.
#
# CloudFront origin check: Nest compares X-Origin-Verify to this value.
# Leave empty for local and e2e (the check is skipped).
ORIGIN_VERIFY_SECRET=
ORIGIN_VERIFY_SECRET_PARAMETER=
# Shared secret for the Arcus companion apps.
ARCUS_SERVICE_TOKEN=
ARCUS_SERVICE_TOKEN_PARAMETER=
# EmailDetective and gibberish API keys (plain values live further down).
EMAILDETECTIVE_API_KEY_PARAMETER=
GIBBERISH_API_KEY_PARAMETER=

# Arcus companion app roots used in approval-email deep links. Fall back to
# VITE_ARCUS_ATTENDANCE_URL / VITE_ARCUS_EVALUATION_URL below.
ARCUS_ATTENDANCE_URL=
ARCUS_EVALUATION_URL=
# Days after an event that post-evaluations stay open. Default: 3.
ARCUS_POST_EVALUATION_WINDOW_DAYS=3

# Edge WAF deploy parameters. Nest does not read these. Apply them as WAF
# rate-based rules in front of the Function URL. A block returns 429
# { "message": "Too Many Attempts." }. Session routes are not throttled.
THROTTLE_TTL_SECONDS=60
THROTTLE_READ_LIMIT=60
THROTTLE_WRITE_LIMIT=10

# ───────────────────────────────────────────────────────────────────
# FRONTEND (Vite / React) — read from this root file by vite.config.ts
# Every VITE_* variable is baked into the browser bundle at build
# time and is PUBLIC. Never put secrets here.
# ───────────────────────────────────────────────────────────────────
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_8n74mhAnM
VITE_COGNITO_CLIENT_ID=heefkupi7cqt26k6cgsgglujh
VITE_COGNITO_DOMAIN=https://ap-southeast-18n74mhanm.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5176
VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:5176
VITE_COGNITO_SCOPES="openid profile email"
# Close and clear idle authentication modals after this many seconds.
VITE_SIGNIN_INACTIVITY_TIMEOUT_SECONDS=3
VITE_SIGNUP_INACTIVITY_TIMEOUT_SECONDS=3

# Backend API base. Use the local Nest server (`npm run start:dev`, PORT above)
# for co-development, or the deployed URL when only working on the frontend.
VITE_API_BASE_URL=http://localhost:3000/api/v2
# VITE_API_BASE_URL=https://<cloudfront-domain>/api/v2
# Optional role keys sent as X-Api-Key. The client picks one from the caller's
# Cognito group, then falls back to the request path (students/, signatories/,
# admins/). Leave empty when the API does not require a key.
VITE_API_TOKEN_STUDENT=
VITE_API_TOKEN_SIGNATORY=
VITE_API_TOKEN_ADMIN=
# Set to true to show the admin monitor pages from local sample data instead
# of the API. Leave empty for live data.
VITE_MOCK_MONITOR=

# Clock display format for reservable slot times and event times on the CDM
# desk and the student SAAF reservation step. 12 or 24 (default: 12).
# Note: persisted/exported times always stay canonical 24-hour; this only
# changes how times are shown in the UI.
VITE_TIME_FORMAT=12

# LOCAL TESTING ONLY — lifts the 10-day minimum event-date lead so proposals and
# reservations can be dated today or any date (incl. the past). Read by BOTH the
# SPA (date pickers + validation) and the API. The root .env is gitignored and never used by deployed
# builds, and the backend also hard-gates on APP_ENV != production, so this stays
# off everywhere else. Leave empty (or false) to keep the normal 10-day rule.
VITE_ALLOW_ANY_EVENT_DATE=

# arcus companion apps — deployed base URLs used by the student Tools page and
# the approval-email deep links. The SPA appends /scanner (attendance) and
# /officer (evaluation), so set these to the app roots with no trailing path.
# Leave empty to hide the matching Tools card.
VITE_ARCUS_ATTENDANCE_URL=
VITE_ARCUS_EVALUATION_URL=

# EmailDetective mailbox checker proxied by GET /api/v2/public/validate-email.
# The backend calls emaildetective.io with this key so it never ships in the
# browser bundle. Lookups are credit-metered and cached per email for a day.
# Leave empty and the endpoint reports "unavailable" (forms fail open).
EMAILDETECTIVE_API_KEY=
# Optional override (default https://api.emaildetective.io)
EMAILDETECTIVE_BASE_URL=

# Gibberish input validation, proxied by POST /api/v2/public/detect-gibberish so the
# key never ships in the browser bundle. GIBBERISH_CHECK_ENABLED turns the whole
# feature on/off (leave empty/false to keep it off; text fields never show a check
# spinner and submissions are never blocked). GIBBERISH_API_URL/GIBBERISH_API_KEY are
# read by the backend; VITE_GIBBERISH_CHECK_ENABLED is read by the SPA and must match
# the backend flag to enable the on-blur loading UI. Set all three to true for demos.
GIBBERISH_CHECK_ENABLED=
GIBBERISH_API_URL=
GIBBERISH_API_KEY=
# Bump GIBBERISH_DETECTOR_VERSION after retuning the detector's own thresholds to drop
# every verdict cached under the old tuning; GIBBERISH_CACHE_TTL is the cache window in
# seconds (default 3600).
GIBBERISH_DETECTOR_VERSION=1
GIBBERISH_CACHE_TTL=3600
VITE_GIBBERISH_CHECK_ENABLED=
